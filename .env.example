DEBUG=True
SECRET_KEY=change-me

DATABASE_NAME=financeiro
DATABASE_USER=financeiro
DATABASE_PASSWORD=change-me
# Deixe em branco para rodar localmente com SQLite (zero setup).
# O docker-compose.yml já define DATABASE_HOST=database para os containers.
DATABASE_HOST=
DATABASE_PORT=5432

ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173

# As três variáveis abaixo só têm efeito em produção (config/settings/production.py).
# Enquanto a VPS não tiver HTTPS (sem domínio/certificado ainda), defina as três como False,
# senão o site fica inacessível (redirect infinito para https e cookies de sessão bloqueados).
# Assim que o HTTPS estiver ativo (veja docs/deployment.md), remova as três linhas (o padrão já é seguro).
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

FRONTEND_URL=http://localhost:5173

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@financeiro.local

# Open Finance — https://dashboard.pluggy.ai (crie uma conta e gere as chaves)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_WEBHOOK_SECRET=
